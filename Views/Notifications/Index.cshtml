@model IEnumerable<PruebaCsharp.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="users-page">
    <div class="container">
        <div class="card users-card">
            <div class="users-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2>Notifications Management</h2>
                    <p>Review email notifications sent after reservation creation.</p>
                </div>

                <a asp-controller="Reservations" asp-action="Index" class="btn btn-main">
                    Go to Reservations
                </a>
            </div>

            <div class="form-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-users table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Email Recipient</th>
                                    <th>Subject</th>
                                    <th>Reservation</th>
                                    <th>Date Sent</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.EmailRecipient</td>
                                        <td>@item.Subject</td>
                                        <td>
                                            @item.Reservation.User.Name -
                                            @item.Reservation.SportsFacility.Name
                                        </td>
                                        <td>@item.DateSent.ToString("dd/MM/yyyy hh:mm tt")</td>
                                        <td>
                                            @if (item.WasSent)
                                            {
                                                <span class="badge rounded-pill" style="background:#3EBB9E; color:#0A3C30;">
                                                    Sent
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-danger">
                                                    Failed
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-main">
                                                Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-box">
                        <h4>No notifications found</h4>
                        <p class="mb-3">
                            Notifications will appear here after creating reservations.
                        </p>
                        <a asp-controller="Reservations" asp-action="Create" class="btn btn-main">
                            Create Reservation
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>