@model PruebaCsharp.Models.User

@{
    ViewData["Title"] = "User Details";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="users-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card form-card">
                    <div class="form-header">
                        <h2 class="mb-1">User Details</h2>
                        <p class="mb-0">Review the selected user information.</p>
                    </div>

                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Name</div>
                                    <div class="details-value">@Model.Name</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Document Id</div>
                                    <div class="details-value">@Model.DocumentId</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Phone</div>
                                    <div class="details-value">@Model.Phone</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Email</div>
                                    <div class="details-value">@Model.Email</div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="details-item">
                                    <div class="details-label">Time Register</div>
                                    <div class="details-value">
                                        @Model.TimeRegister.ToString("dd/MM/yyyy hh:mm tt")
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-outline-main">
                                Back to List
                            </a>

                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-main">
                                Edit User
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>