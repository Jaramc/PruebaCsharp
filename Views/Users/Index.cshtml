@model IEnumerable<PruebaCsharp.Models.User>

@{
    ViewData["Title"] = "Users";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="users-page">
    <div class="container">
        <div class="card users-card">
            <div class="users-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2>Users Management</h2>
                    <p>Manage registered users for sports facility reservations.</p>
                </div>

                <a asp-action="Create" class="btn btn-main">
                    Create New User
                </a>
            </div>

            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-users table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Document Id</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Time Register</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td>@user.Name</td>
                                        <td>@user.DocumentId</td>
                                        <td>@user.Phone</td>
                                        <td>@user.Email</td>
                                        <td>@user.TimeRegister.ToString("dd/MM/yyyy hh:mm tt")</td>
                                        <td class="text-center">
                                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-main me-2">
                                                Details
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-dark-main">
                                                Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4">
                        <div class="empty-box">
                            <h4>No users registered yet</h4>
                            <p class="mb-3">Start by creating your first user.</p>
                            <a asp-action="Create" class="btn btn-main">Create New User</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>