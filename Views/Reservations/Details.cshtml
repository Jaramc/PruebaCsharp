@model PruebaCsharp.Models.Reservation

@{
    ViewData["Title"] = "Reservation Details";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="users-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card form-card">
                    <div class="form-header">
                        <h2 class="mb-1">Reservation Details</h2>
                        <p class="mb-0">Review the selected reservation information.</p>
                    </div>

                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">User</div>
                                    <div class="details-value">@Model.User.Name</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Document Id</div>
                                    <div class="details-value">@Model.User.DocumentId</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Sports Facility</div>
                                    <div class="details-value">@Model.SportsFacility.Name</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Type Of Space</div>
                                    <div class="details-value">@Model.SportsFacility.TypeOfSpace</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Reservation Date</div>
                                    <div class="details-value">@Model.ReservationDate.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Status</div>
                                    <div class="details-value">@Model.Status</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Start Time</div>
                                    <div class="details-value">@Model.StartTime.ToString(@"hh\:mm")</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">End Time</div>
                                    <div class="details-value">@Model.EndTime.ToString(@"hh\:mm")</div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="details-item">
                                    <div class="details-label">Created At</div>
                                    <div class="details-value">@Model.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-outline-main">
                                Back to List
                            </a>

                            <a asp-action="Create" class="btn btn-main">
                                Create Another Reservation
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>