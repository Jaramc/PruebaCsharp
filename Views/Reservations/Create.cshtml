@model PruebaCsharp.ViewModels.ReservationCreateViewModel

@{
    ViewData["Title"] = "Create Reservation";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="users-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="card form-card">
                    <div class="form-header">
                        <h2 class="mb-1">Create Reservation</h2>
                        <p class="mb-0">Select a registered user and an available sports facility.</p>
                    </div>

                    <div class="form-body">
                        <form asp-action="Create" method="post">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">User</label>
                                <select asp-for="UserId" asp-items="Model.Users" class="form-control">
                                    <option value="0">Select a user</option>
                                </select>
                                <span asp-validation-for="UserId"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SportsFacilityId" class="form-label">Sports Facility</label>
                                <select asp-for="SportsFacilityId" asp-items="Model.SportsFacilities" class="form-control">
                                    <option value="0">Select a sports facility</option>
                                </select>
                                <span asp-validation-for="SportsFacilityId"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ReservationDate" class="form-label">Reservation Date</label>
                                <input asp-for="ReservationDate" type="date" class="form-control" />
                                <span asp-validation-for="ReservationDate"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="StartTime" class="form-label">Start Time</label>
                                <input asp-for="StartTime" type="time" class="form-control" />
                                <span asp-validation-for="StartTime"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="EndTime" class="form-label">End Time</label>
                                <input asp-for="EndTime" type="time" class="form-control" />
                                <span asp-validation-for="EndTime"></span>
                            </div>

                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-outline-main">
                                    Back to List
                                </a>

                                <button type="submit" class="btn btn-main">
                                    Create Reservation
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}