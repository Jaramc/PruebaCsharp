@model PruebaCsharp.Models.SportsFacility

@{
    ViewData["Title"] = "Sports Facility Details";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="users-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card form-card">
                    <div class="form-header">
                        <h2 class="mb-1">Sports Facility Details</h2>
                        <p class="mb-0">Review the selected sports facility information.</p>
                    </div>

                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Name</div>
                                    <div class="details-value">@Model.Name</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Type Of Space</div>
                                    <div class="details-value">@Model.TypeOfSpace</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Capacity</div>
                                    <div class="details-value">@Model.Capacity</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="details-item">
                                    <div class="details-label">Availability</div>
                                    <div class="details-value">@Model.Availability</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-outline-main">
                                Back to List
                            </a>

                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-main">
                                Edit
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>