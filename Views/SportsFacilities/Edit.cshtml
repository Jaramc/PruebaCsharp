@model PruebaCsharp.Models.SportsFacility

@{
    ViewData["Title"] = "Edit Sports Facility";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="users-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="card form-card">
                    <div class="form-header">
                        <h2 class="mb-1">Edit Sports Facility</h2>
                        <p class="mb-0">Update the selected sports facility information.</p>
                    </div>

                    <div class="form-body">
                        <form asp-action="Edit" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="Id" />

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="TypeOfSpace" class="form-label">Type Of Space</label>
                                <select asp-for="TypeOfSpace" class="form-control" asp-items="ViewBag.TypeOfSpaces"></select>
                                <span asp-validation-for="TypeOfSpace"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Capacity" class="form-label"></label>
                                <input asp-for="Capacity" class="form-control" />
                                <span asp-validation-for="Capacity"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Availability" class="form-label"></label>
                                <select asp-for="Availability" class="form-control" asp-items="ViewBag.AvailabilityStatuses"></select>
                                <span asp-validation-for="Availability"></span>
                            </div>

                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-outline-main">
                                    Back to List
                                </a>

                                <button type="submit" class="btn btn-main">
                                    Save
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}