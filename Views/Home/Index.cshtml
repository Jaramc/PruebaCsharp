@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="users-page">
    <div class="container">

        <div class="card users-card mb-4">
            <div class="users-header text-center">
                <h2 class="mb-2">Sports Reservation System</h2>
                <p class="mb-0">
                    Manage users, sports facilities, reservations and notifications in one place.
                </p>
            </div>

            <div class="form-body">
                <div class="row align-items-center">
                    <div class="col-lg-7 text-center text-lg-start mb-4 mb-lg-0">
                        <span class="badge rounded-pill px-3 py-2 mb-3" style="background:#73E6CB; color:#0A3C30;">
                            Sports Management Platform
                        </span>

                        <h1 class="mb-3" style="color:#0A3C30; font-weight:800; font-size:3rem;">
                            Welcome to your reservation control panel
                        </h1>

                        <p class="mb-4" style="color:#00674F; font-size:1.15rem; line-height:1.7;">
                            Register users, manage sports spaces, control availability and organize reservations with a clean and simple system.
                        </p>

                        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                            <a asp-controller="Users" asp-action="Index" class="btn btn-main">
                                <i class="bi bi-people-fill me-2"></i>
                                Manage Users
                            </a>

                            <a asp-controller="SportsFacilities" asp-action="Index" class="btn btn-outline-main">
                                <i class="bi bi-building me-2"></i>
                                Manage Sports Facilities
                            </a>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="p-4 rounded-4" style="background:linear-gradient(135deg,#0A3C30,#00674F); box-shadow:0 15px 35px rgba(10,60,48,.25);">
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="text-center p-3 rounded-4" style="background:rgba(255,255,255,.12); color:white;">
                                        <i class="bi bi-people-fill" style="font-size:2.4rem; color:#73E6CB;"></i>
                                        <h5 class="mt-3 mb-1">Users</h5>
                                        <small style="color:#d9fff6;">Client records</small>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="text-center p-3 rounded-4" style="background:rgba(255,255,255,.12); color:white;">
                                        <i class="bi bi-building" style="font-size:2.4rem; color:#73E6CB;"></i>
                                        <h5 class="mt-3 mb-1">Facilities</h5>
                                        <small style="color:#d9fff6;">Sports spaces</small>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="text-center p-3 rounded-4" style="background:rgba(255,255,255,.12); color:white;">
                                        <i class="bi bi-calendar-check-fill" style="font-size:2.4rem; color:#73E6CB;"></i>
                                        <h5 class="mt-3 mb-1">Reservations</h5>
                                        <small style="color:#d9fff6;">Schedule control</small>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="text-center p-3 rounded-4" style="background:rgba(255,255,255,.12); color:white;">
                                        <i class="bi bi-envelope-check-fill" style="font-size:2.4rem; color:#73E6CB;"></i>
                                        <h5 class="mt-3 mb-1">Notifications</h5>
                                        <small style="color:#d9fff6;">Email tracking</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="details-item h-100">
                    <i class="bi bi-person-plus-fill" style="font-size:2rem; color:#3EBB9E;"></i>
                    <div class="details-label mt-3">Step 1</div>
                    <div class="details-value mb-2">Register Users</div>
                    <p class="mb-0" style="color:#00674F;">
                        Create users with document, phone and valid email information.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="details-item h-100">
                    <i class="bi bi-grid-1x2-fill" style="font-size:2rem; color:#3EBB9E;"></i>
                    <div class="details-label mt-3">Step 2</div>
                    <div class="details-value mb-2">Create Facilities</div>
                    <p class="mb-0" style="color:#00674F;">
                        Add courts, pools, gyms and other spaces with capacity and availability.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="details-item h-100">
                    <i class="bi bi-calendar2-week-fill" style="font-size:2rem; color:#3EBB9E;"></i>
                    <div class="details-label mt-3">Step 3</div>
                    <div class="details-value mb-2">Manage Reservations</div>
                    <p class="mb-0" style="color:#00674F;">
                        Control active, canceled and completed reservations without schedule conflicts.
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>